{
  "name": "kaede",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:legacy-recordings": "tsx src/cli/migrate-legacy-recordings-to-data-assets.ts",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:s3": "vitest run --config vitest.s3.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "db:codegen": "kysely-codegen --dialect postgres --default-schema public --exclude-pattern public.schema_migrations --out-file ./src/services/db/generated.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "@aws-sdk/s3-request-presigner": "^3.1158.0",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.10.20",
    "@sentry/node": "^10.77.1",
    "argon2": "^0.44.0",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "kysely": "^0.28.18",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/eslint-config": "^2.1.1",
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/ui": "4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "kysely-codegen": "^0.20.0",
    "prettier": "^3.9.10",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=11.18.0"
  }
}
